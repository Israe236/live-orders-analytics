# Copy to .env. The phone must reach the API over your network, so use your computer's LAN IP,
# not "localhost" (on the phone, localhost is the phone itself).
#   Windows: ipconfig    macOS/Linux: ip addr / ifconfig
# Android emulator: http://10.0.2.2:8000    iOS simulator / Expo web: http://localhost:8000
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
