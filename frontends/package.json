{
  "name": "rad-frontends",
  "private": true,
  "description": "Dashboards for the realtime analytics pipeline: shared core, React, Angular, React Native.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:core": "npm run build -w @rad/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
