# Copy to .env to override defaults. Every value has a working default in docker-compose.yml.
POSTGRES_USER=rad
POSTGRES_PASSWORD=rad
POSTGRES_DB=rad
POSTGRES_PORT=5432
API_PORT=8000

# Event generator
GEN_EVENTS_PER_SECOND=20
# 1 = real time; 1440 = one simulated day per real minute (to watch the daily curve)
GEN_TIME_COMPRESSION=1
GEN_INVALID_RATIO=0.01
GEN_BURSTS_PER_HOUR=4
GEN_ANOMALIES_PER_HOUR=2
